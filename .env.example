# Gridbricks UK Wind Forecast Platform - Environment Configuration

# Backend Configuration
HOST=0.0.0.0
PORT=8000
PYTHONPATH=/app
LOG_LEVEL=info

# Frontend Configuration
# In local development via Vite or Docker Compose Nginx proxy, leave this empty to use relative paths.
# In production pointing to a remote backend (e.g., Vercel to Render), provide the full backend origin.
VITE_API_BASE_URL=
